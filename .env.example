# Runtime
PIXEL_RELAY_HOST=0.0.0.0
PIXEL_RELAY_PORT=8741
# Optional. Defaults to %LOCALAPPDATA%\PixelRelay on Windows,
# ~/Library/Application Support/PixelRelay on macOS, and
# $XDG_STATE_HOME/pixel-relay (or ~/.local/state/pixel-relay) on Linux.
# PIXEL_RELAY_DATA_DIR=C:/Users/yourname/AppData/Local/PixelRelay

# Pixel
PIXEL_RELAY_DEVICE_SERIAL=192.168.1.35:5555
PIXEL_RELAY_CONNECTION_MODE=usb
PIXEL_RELAY_FTP_HOST=192.168.1.35
PIXEL_RELAY_FTP_PORT=21
PIXEL_RELAY_FTP_USERNAME=anonymous
PIXEL_RELAY_FTP_PASSWORD=
PIXEL_RELAY_FTP_DESTINATION_ROOT=/DCIM/Camera/PixelRelay
# Leave blank to use the phone's internal shared storage (the default).
# Set an adopted-storage UUID only when external adopted storage is intentional.
PIXEL_RELAY_EXPECTED_PRIMARY_UUID=
PIXEL_RELAY_DESTINATION_ROOT=/sdcard/DCIM/Camera/PixelRelay
PIXEL_RELAY_ADB_PATH=adb
# General probes stay short; large uploads, checksums, and batch purges use the long timeout.
PIXEL_RELAY_COMMAND_TIMEOUT_SECONDS=30
PIXEL_RELAY_PUSH_TIMEOUT_SECONDS=3600

# Browser-uploaded originals default to ./data. Override with an absolute path
# when a NAS or another durable location should be used instead.
# PIXEL_RELAY_IMPORT_ROOT=D:/TheDoPixelImports

# Set true only when the service itself is reached over HTTPS.
PIXEL_RELAY_SECURE_COOKIES=false
PIXEL_RELAY_TRUSTED_PROXY=false

# Safety limits
PIXEL_RELAY_MAX_BATCH_FILES=6000
PIXEL_RELAY_MAX_BATCH_BYTES=429496729600
PIXEL_RELAY_RESERVE_BYTES=10737418240
PIXEL_RELAY_RESERVE_PERCENT=10
PIXEL_RELAY_PAUSE_TEMPERATURE_C=42
PIXEL_RELAY_RESUME_TEMPERATURE_C=38
